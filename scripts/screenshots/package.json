{
  "name": "docs-dashboard-screenshots",
  "private": true,
  "description": "Playwright capture and diff pipeline for Auth0 Dashboard screenshots in main/docs/images",
  "scripts": {
    "auth": "playwright test --project=setup --headed",
    "diff": "playwright test --project=capture",
    "capture": "playwright test --project=capture --update-snapshots",
    "report": "node report.js",
    "build-manifest": "node build-manifest.js",
    "update-refs": "node update-screenshot-refs.js",
    "propose": "node propose.js",
    "verify": "node propose.js verify",
    "test": "node --test update-screenshot-refs.test.js propose.test.js"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@playwright/test": "1.52.0",
    "zod": "^4.0.0"
  }
}
