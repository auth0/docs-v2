{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Auth0 Docs",
  "description": "Auth0 documentation",
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "seo": {
    "metatags": {
      "canonical": "https://auth0.com",
      "og:image": "docs/images/share-image.png"
    }
  },
  "colors": {
    "primary": "#9921FE",
    "light": "#BC6DFF",
    "dark": "#343434"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "fonts": {
    "body": {
      "family": "Inter",
      "source": "https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap",
      "format": "woff2"
    }
  },
  "integrations": {
    "gtm": {
      "tagId": "GTM-W7FRLJ"
    },
    "onetrust": {
      "domainScript": "96e22fd8-d619-4cdd-a3c6-d51529d21faf",
      "categoryId": "C0002",
      "scriptSource": "https://cdn.cookielaw.org/scripttemplates/otSDKStub.js"
    },
    "heap": {
      "appId": "1279799279"
    },
    "adobe": {
      "launchUrl": "https://assets.adobedtm.com/6bb3f7663515/7006851c9849/launch-af624fe9e34f.min.js"
    }
  },
  "api": {
    "url": "full",
    "playground": {
      "proxy": false
    },
    "params": {
      "post": [
        "x-release-lifecycle"
      ]
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "$ref": "config/nav.json"
      },
      {
        "language": "fr-ca",
        "$ref": "config/fr-ca/nav.json"
      },
      {
        "language": "ja-jp",
        "$ref": "config/ja-jp/nav.json"
      }
    ]
  },
  "logo": {
    "light": "/docs/images/logo/light.svg",
    "dark": "/docs/images/logo/dark.svg",
    "href": "https://auth0.com/docs/"
  },
  "favicon": "/docs/images/logo/favicon.svg",
  "redirects": {
    "$ref": "config/redirects.json"
  }
}