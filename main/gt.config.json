{
  "$schema": "https://assets.gtx.dev/config-schema.json",
  "locales": [
    "fr-ca",
    "ja-jp"
  ],
  "defaultLocale": "en",
  "customMapping": {
    "fr-ca": {
      "code": "fr-CA",
      "name": "French (Canada)"
    },
    "ja-jp": {
      "code": "ja",
      "name": "Japanese"
    }
  },
  "files": {
    "json": {
      "include": [
        "./config/nav.json"
      ],
      "transform": {
        "match": "^([docs|config]/)(.*)$",
        "replace": "$1{locale}/$2"
      }
    }
  },
  "options": {
    "experimentalClearLocaleDirs": true,
    "jsonSchema": {
      "./nav.json": {
        "resolveRefs": true,
        "include": [
          "$..group",
          "$..tab",
          "$..item",
          "$..anchor",
          "$..dropdown",
          "$..product",
          "$..description",
          "$..header",
          "$..label"
        ],
        "omitProperties": [
          "default"
        ],
        "transform": {
          "$..pages[*]": {
            "match": "^docs/(.*)$",
            "replace": "docs/{locale}/$1"
          },
          "$..root": {
            "match": "^docs/(.*)$",
            "replace": "docs/{locale}/$1"
          }
        }
      }
    },
    "docsUrlPattern": "/docs/[locale]",
    "docsImportPattern": "/snippets/[locale]",
    "generateRedirects": "./docs.json",
    "experimentalLocalizeStaticUrls": true,
    "experimentalLocalizeRelativeAssets": true,
    "docsHideDefaultLocaleImport": true,
    "experimentalHideDefaultLocale": true,
    "experimentalAddHeaderAnchorIds": "mintlify"
  }
}
