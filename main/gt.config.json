{
  "$schema": "https://assets.gtx.dev/config-schema.json",
  "locales": [
    "fr-ca",
    "ja-jp"
  ],
  "defaultLocale": "en",
  "customMapping": {
    "fr-ca": {
      "code": "fr-CA",
      "name": "French (Canada)"
    },
    "ja-jp": {
      "code": "ja",
      "name": "Japanese"
    }
  },
  "files": {
    "json": {
      "include": [
        "./docs.json",
        "./docs/oas/**/*.json"
      ],
      "exclude": [
        "./docs/[locales]/oas/**/*.json",
        "./config/[locales]/navigation/**/*.json",
        "./config/[locales]/nav.json"
      ],
      "transform": {
        "match": "^(docs/)(.*)$",
        "replace": "$1{locale}/$2"
      }
    },
    "mdx": {
      "include": [
        "./docs/**/*.mdx",
        "./docs/**/.*.mdx"
      ],
      "exclude": [
        "./docs/[locales]/**/*.mdx"
      ],
      "transform": {
        "match": "^(docs/)?(.*)$",
        "replace": "$1{locale}/$2"
      }
    },
    "js": {
      "include": [
        "./snippets/**/*.jsx"
      ],
      "exclude": [
        "./snippets/[locales]/**/*.jsx"
      ],
      "transform": {
        "match": "^(snippets/)?(.*)$",
        "replace": "$1{locale}/$2"
      }
    }
  },
  "options": {
    "experimentalClearLocaleDirs": true,
    "mintlify": {
      "inferTitleFromFilename": true,
      "openapi": {
        "files": [
          "./docs/oas/authentication/authentication-api-oas.json",
          "./docs/oas/events/events-schema.json",
          "./docs/oas/management/v2/management-api-oas.json",
          "./docs/oas/myaccount/myaccount-api-oas.json",
          "./docs/oas/myorganization/myorganization-api-oas.json",
          "./docs/oas/tenant-logs/logs-schema.json"
        ]
      }
    },
    "jsonSchema": {
      "./docs.json": {
        "resolveRefs": true,
        "composite": {
          "$.navigation.languages": {
            "type": "array",
            "key": "$.language",
            "splitEntries": true,
            "experimentalSort": "localesAlphabetical",
            "include": [
              "$..group",
              "$..tab",
              "$..item",
              "$..anchor",
              "$..dropdown",
              "$..product",
              "$..description",
              "$..header",
              "$..label"
            ],
            "omitProperties": [
              "default"
            ],
            "transform": {
              "$..pages[*]": {
                "match": "^docs/(.*)$",
                "replace": "docs/{locale}/$1"
              },
              "$..root": {
                "match": "^docs/(.*)$",
                "replace": "docs/{locale}/$1"
              }
            }
          }
        }
      },
      "./docs/oas/**/*.json": {
        "include": [
          "$..summary",
          "$..description",
          "$.info.title"
        ]
      }
    },
    "skipFileValidation": {
      "mdx": true
    },
    "docsUrlPattern": "/docs/[locale]",
    "docsImportPattern": "/snippets/[locale]",
    "generateRedirects": "./docs.json",
    "experimentalLocalizeStaticImports": true,
    "experimentalLocalizeStaticUrls": true,
    "experimentalLocalizeRelativeAssets": true,
    "docsHideDefaultLocaleImport": true,
    "experimentalHideDefaultLocale": true,
    "experimentalAddHeaderAnchorIds": "mintlify"
  }
}