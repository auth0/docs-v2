{"parents": [{"link": "../../../", "title": "API Reference"}, {"link": "../../", "title": "Auth0 Fastapi"}, {"link": "../", "title": "Stores"}], "prev": {"link": "../", "title": "Stores"}, "next": {"link": "../stateful_state_store/", "title": "Stateful State Store"}, "title": "Cookie Transaction Store", "meta": {}, "body": "<section id=\"module-auth0_fastapi.stores.cookie_transaction_store\">\n<span id=\"cookie-transaction-store\"></span><h1>Cookie Transaction Store<a class=\"headerlink\" href=\"#module-auth0_fastapi.stores.cookie_transaction_store\" title=\"Link to this heading\">\u00b6</a></h1>\n<section id=\"classes\">\n<h2>Classes<a class=\"headerlink\" href=\"#classes\" title=\"Link to this heading\">\u00b6</a></h2>\n<div class=\"table-wrapper autosummary longtable docutils container\">\n<table class=\"autosummary longtable docutils align-default\">\n<tbody>\n<tr class=\"row-odd\"><td><p><a class=\"reference internal\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore\" title=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore\"><code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">CookieTransactionStore</span></code></a></p></td>\n<td><p>Transaction store implementation that uses a cookie to store transaction data.</p></td>\n</tr>\n</tbody>\n</table>\n</div>\n</section>\n<section id=\"module-contents\">\n<h2>Module Contents<a class=\"headerlink\" href=\"#module-contents\" title=\"Link to this heading\">\u00b6</a></h2>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">auth0_fastapi.stores.cookie_transaction_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">CookieTransactionStore</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">secret</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">cookie_name</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">'_a0_tx'</span></span></em><span class=\"sig-paren\">)</span><a class=\"reference internal\" href=\"../../../../_modules/auth0_fastapi/stores/cookie_transaction_store/#CookieTransactionStore\"><span class=\"viewcode-link\"><span class=\"pre\">[source]</span></span></a><a class=\"headerlink\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <code class=\"xref py py-obj docutils literal notranslate\"><span class=\"pre\">auth0_server_python.store.abstract.TransactionStore</span></code></p>\n<p>Transaction store implementation that uses a cookie to store transaction data.\nThis store expects the FastAPI Request and Response objects to be provided in the\nstore_options parameter.</p>\n<p>Initialize the data store with options.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>options</strong> \u2013 Configuration options including encryption secret</p>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.delete\">\n<em class=\"property\"><span class=\"pre\">async</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">delete</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">identifier</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#dict\" title=\"(in Python v3.14)\"><span class=\"pre\">dict</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span></span><a class=\"reference internal\" href=\"../../../../_modules/auth0_fastapi/stores/cookie_transaction_store/#CookieTransactionStore.delete\"><span class=\"viewcode-link\"><span class=\"pre\">[source]</span></span></a><a class=\"headerlink\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.delete\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Deletes the transaction cookie.\nExpects \u2018response\u2019 in options.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.get\">\n<em class=\"property\"><span class=\"pre\">async</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">get</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">identifier</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#dict\" title=\"(in Python v3.14)\"><span class=\"pre\">dict</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span></span><a class=\"reference internal\" href=\"../../../../_modules/auth0_fastapi/stores/cookie_transaction_store/#CookieTransactionStore.get\"><span class=\"viewcode-link\"><span class=\"pre\">[source]</span></span></a><a class=\"headerlink\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.get\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Retrieves and parses the transaction data from the cookie.\nExpects \u2018request\u2019 in options.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.set\">\n<em class=\"property\"><span class=\"pre\">async</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">set</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">identifier</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">value</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><span class=\"pre\">auth0_server_python.auth_types.TransactionData</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">options</span></span><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><span class=\"n\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#dict\" title=\"(in Python v3.14)\"><span class=\"pre\">dict</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/stdtypes.html#str\" title=\"(in Python v3.14)\"><span class=\"pre\">str</span></a><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><span class=\"pre\">Any</span><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span><span class=\"w\"> </span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span> <span class=\"sig-return\"><span class=\"sig-return-icon\">&#x2192;</span> <span class=\"sig-return-typehint\"><a class=\"reference external\" href=\"https://docs.python.org/3/builtins/constants.html#None\" title=\"(in Python v3.14)\"><span class=\"pre\">None</span></a></span></span><a class=\"reference internal\" href=\"../../../../_modules/auth0_fastapi/stores/cookie_transaction_store/#CookieTransactionStore.set\"><span class=\"viewcode-link\"><span class=\"pre\">[source]</span></span></a><a class=\"headerlink\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.set\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Encrypts and stores the transaction data in a cookie.\nExpects \u2018response\u2019 in options.</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.cookie_name\">\n<span class=\"sig-name descname\"><span class=\"pre\">cookie_name</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'_a0_tx'</span></em><a class=\"headerlink\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.cookie_name\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n</dd></dl>\n\n</section>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["reference/auth0_fastapi/stores/stateful_state_store/index", "Stateful State Store", "N", "next"], ["reference/auth0_fastapi/stores/index", "Stores", "P", "previous"]], "sourcename": "reference/auth0_fastapi/stores/cookie_transaction_store/index.rst.txt", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Cookie Transaction Store</a><ul>\n<li><a class=\"reference internal\" href=\"#classes\">Classes</a></li>\n<li><a class=\"reference internal\" href=\"#module-contents\">Module Contents</a><ul>\n<li><a class=\"reference internal\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore\"><code class=\"docutils literal notranslate\"><span class=\"pre\">CookieTransactionStore</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#auth0_fastapi.stores.cookie_transaction_store.CookieTransactionStore.delete\"><code class=\"docutils literal notranslate\"><span class=\"pre\">CookieTransactionStore.delete()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#auth0_fastapi.stores.cooki